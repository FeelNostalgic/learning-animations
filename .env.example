# ==============================================================================
# LEARNING ANIMATIONS — ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo a `.env.local` en la raíz del proyecto para desarrollo local:
#   cp .env.example .env.local
#
# Ninguna variable de este archivo contiene secretos reales; es una guía de
# referencia exhaustiva para configurar los servicios necesarios.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de Datos Postgres, Autenticación y Row-Level Security)
# ------------------------------------------------------------------------------
# ¿Qué es?: Conexión principal para autenticación de usuarios y almacenamiento
# de las animaciones interactivas (esquema UniversalAnimationData).
#
# ¿Dónde obtenerlo?:
#   1. Inicia sesión en https://supabase.com/dashboard
#   2. Selecciona o crea tu proyecto.
#   3. Ve a: Project Settings (icono de engranaje) -> API
#   4. Copia el "Project URL" y el "anon public API Key".

NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica-aqui"


# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 (Almacenamiento de Imágenes y Assets con CDN de Alta Velocidad)
# ------------------------------------------------------------------------------
# ¿Qué es?: Servicio de almacenamiento S3 compatible con 10 GB gratuitos al mes
# y 0 costes por transferencia de datos saliente (Zero Egress Fees), utilizado
# para almacenar imágenes subidas al Studio y servirlas mediante CDN global.
#
# ¿Dónde obtenerlo?:
#   1. Inicia sesión en https://dash.cloudflare.com
#   2. En el menú lateral izquierdo, ve a "R2 Object Storage".
#   3. Crea un nuevo bucket (ejemplo: "learning-animations-assets").
#   4. En la página de R2, haz clic en "Manage R2 API Tokens" -> "Create API Token".
#   5. Asigna permisos de "Object Read & Write" al bucket creado y genera el token.
#   6. Obtén:
#      - Account ID: Visible en la barra lateral derecha de la página principal de R2.
#      - Access Key ID y Secret Access Key: Mostrados al crear el token API.
#      - Public URL: En la pestaña "Settings" de tu bucket -> "Public Development URL"
#        (o conecta tu dominio personalizado con SSL gratuito).

R2_ACCOUNT_ID="tu-cloudflare-account-id"
R2_ACCESS_KEY_ID="tu-r2-access-key-id"
R2_SECRET_ACCESS_KEY="tu-r2-secret-access-key"
R2_BUCKET_NAME="learning-animations-assets"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-tu-id.r2.dev"
